# Broker Selection: FYERS, ANGEL, or MOCK
BROKER=FYERS

# Fyers API v3 Credentials
FYERS_CLIENT_ID=your_fyers_app_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_ACCESS_TOKEN=your_fyers_access_token

# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_CODE=your_angel_client_code
ANGEL_PASSWORD=your_angel_password
ANGEL_TOTP_SECRET=your_angel_totp_secret
ANGEL_FEED_TOKEN=your_angel_feed_token

# AI Model Decision Threshold (0.50 to 0.90)
AI_DECISION_THRESHOLD=0.60
